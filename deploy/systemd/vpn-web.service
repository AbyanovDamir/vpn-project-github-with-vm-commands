[Unit]
Description=VPN Lab web application
After=network-online.target wg-quick@wg0.service oauth-server.service
Requires=wg-quick@wg0.service oauth-server.service

[Service]
Type=simple
User=vpnlab
WorkingDirectory=/opt/vpn-lab/app
EnvironmentFile=/etc/vpn-lab.env
ExecStart=/usr/bin/python3 /opt/vpn-lab/app/web_app.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

