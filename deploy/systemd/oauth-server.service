[Unit]
Description=VPN Lab OAuth 2.0 authorization server
After=network-online.target wg-quick@wg0.service
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=vpnlab
WorkingDirectory=/opt/vpn-lab/app
EnvironmentFile=/etc/vpn-lab.env
ExecStart=/usr/bin/python3 /opt/vpn-lab/app/oauth_server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

